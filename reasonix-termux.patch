new file mode 100644
index 0000000000000000000000000000000000000000..922ae6ba7e0c1f0d594f155c373948e4a7841ddd
--- /dev/null
+++ b/internal/config/model_effort.go
@@ -0,0 +1,40 @@
+package config
+
+import "fmt"
+
+// SetRuntimeEffort keeps session/role overrides above persisted model settings.
+func (e *ProviderEntry) SetRuntimeEffort(effort string) {
+	e.Effort = effort
+	e.effortRuntime = true
+}
+
+// SetModelEffort changes only this model. Nil restores connection inheritance;
+// an explicit empty string selects auto, even if the connection pins an effort.
+func (c *Config) SetModelEffort(name, model string, effort *string) error {
+	entry, ok := c.Provider(name)
+	selected, found := c.ResolveModel(name + "/" + model)
+	if !ok || !found || selected.Name != name {
+		return fmt.Errorf("unknown model %s/%s", name, model)
+	}
+	if effort != nil && *effort != "" {
+		if _, err := NormalizeEffort(selected, *effort); err != nil {
+			return err
+		}
+	}
+	entry.ModelOverrides = cloneModelOverrideMap(entry.ModelOverrides)
+	ov := entry.ModelOverrides[model]
+	ov.Effort = nil
+	if effort != nil {
+		value := normalizeStoredEffort(*effort)
+		ov.Effort = &value
+	}
+	if entry.ModelOverrides == nil {
+		entry.ModelOverrides = map[string]ProviderModelOverride{}
+	}
+	if modelOverrideEmpty(ov) {
+		delete(entry.ModelOverrides, model)
+	} else {
+		entry.ModelOverrides[model] = ov
+	}
+	return nil
+}
diff --git a/internal/config/model_effort_test.go b/internal/config/model_effort_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..186379f0d8d502fd46b4eb8e8c8f5371478ba488
--- /dev/null
+++ b/internal/config/model_effort_test.go
@@ -0,0 +1,114 @@
+package config
+
+import (
+	"path/filepath"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+func TestModelEffortIndependentRoundTripAndRuntimePriority(t *testing.T) {
+	cfg := &Config{Providers: []ProviderEntry{{Name: "relay", Kind: "openai", BaseURL: "https://relay.test/v1", Models: []string{"a", "b"}, Effort: "high", ReasoningProtocol: "openai", SupportedEfforts: []string{"low", "high"}, DefaultEffort: "low"}}}
+	low := "low"
+	if err := cfg.SetModelEffort("relay", "a", &low); err != nil {
+		t.Fatal(err)
+	}
+	a, _ := cfg.ResolveModel("relay/a")
+	b, _ := cfg.ResolveModel("relay/b")
+	if EffectiveEffort(a) != "low" || EffectiveEffort(b) != "high" {
+		t.Fatal("model effort leaked to sibling")
+	}
+	a.SetRuntimeEffort("high")
+	if EffectiveEffort(a) != "high" {
+		t.Fatal("session effort lost to model setting")
+	}
+	auto := ""
+	if err := cfg.SetModelEffort("relay", "a", &auto); err != nil {
+		t.Fatal(err)
+	}
+	a, _ = cfg.ResolveModel("relay/a")
+	if EffectiveEffort(a) != "low" {
+		t.Fatal("model auto inherited pinned connection effort")
+	}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	if err := cfg.SaveTo(path); err != nil {
+		t.Fatal(err)
+	}
+	loaded := LoadForEditWithoutCredentials(path)
+	if loaded.Providers[0].ModelOverrides["a"].Effort == nil {
+		t.Fatal("explicit auto lost on save")
+	}
+	if err := loaded.SetModelEffort("relay", "a", nil); err != nil {
+		t.Fatal(err)
+	}
+	a, _ = loaded.ResolveModel("relay/a")
+	if EffectiveEffort(a) != "high" {
+		t.Fatal("inherit did not restore connection")
+	}
+}
+
+func TestDiscoveredReasoningIsScopedAndManualWins(t *testing.T) {
+	t.Setenv("REASONIX_HOME", t.TempDir())
+	e := ProviderEntry{Name: "relay", Kind: "openai", BaseURL: "http://127.0.0.1:8790/v1", Models: []string{"a", "b"}}
+	e.ApplyDiscoveredReasoning([]provider.ModelInfo{{ID: "a", ReasoningInfo: &provider.ModelReasoningInfo{Protocol: "openai", Efforts: []string{"low", "high"}, Default: "low"}}})
+	cfg := &Config{Providers: []ProviderEntry{e}}
+	a, _ := cfg.ResolveModel("relay/a")
+	if EffectiveEffort(a) != "low" || ReasoningCapabilityForEntry(a).Unknown {
+		t.Fatalf("discovery not active: %+v", a)
+	}
+	b, _ := cfg.ResolveModel("relay/b")
+	if !ReasoningCapabilityForEntry(b).Unknown {
+		t.Fatal("discovery applied to sibling")
+	}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	if err := cfg.SaveTo(path); err != nil {
+		t.Fatal(err)
+	}
+	loaded := LoadForEditWithoutCredentials(path)
+	a, _ = loaded.ResolveModel("relay/a")
+	if EffectiveEffort(a) != "low" {
+		t.Fatal("discovery did not roundtrip")
+	}
+	ov := loaded.Providers[0].ModelOverrides["a"]
+	ov.ReasoningProtocol = "none"
+	loaded.Providers[0].ModelOverrides["a"] = ov
+	a, _ = loaded.ResolveModel("relay/a")
+	if ReasoningCapabilityForEntry(a).State() != "unsupported" {
+		t.Fatal("discovery overwrote manual none")
+	}
+	loaded.Providers[0].BaseURL = "https://other.test/v1"
+	ov.ReasoningProtocol = ""
+	loaded.Providers[0].ModelOverrides["a"] = ov
+	a, _ = loaded.ResolveModel("relay/a")
+	if !ReasoningCapabilityForEntry(a).Unknown {
+		t.Fatal("new endpoint inherited old declaration")
+	}
+}
+
+func TestDiscoveredReasoningExpiresAndCloneIsIndependent(t *testing.T) {
+	t.Setenv("REASONIX_HOME", t.TempDir())
+	e := ProviderEntry{Name: "relay", Kind: "openai", BaseURL: "https://relay.test", Model: "a"}
+	e.ApplyDiscoveredReasoning([]provider.ModelInfo{{ID: "a", ReasoningInfo: &provider.ModelReasoningInfo{Protocol: "openai", Efforts: []string{"low", "high"}, Default: "low"}}})
+	copy := cloneModelOverrideMap(e.ModelOverrides)
+	copy["a"].DiscoveredReasoning.Efforts[0] = "changed"
+	if e.ModelOverrides["a"].DiscoveredReasoning.Efforts[0] != "low" {
+		t.Fatal("clone shares discovery slice")
+	}
+	runtime := ResolveReasoningEntry(&e)
+	e.ModelOverrides["a"].DiscoveredReasoning.ExpiresAt = 1
+	if got := ResolveReasoningEntry(runtime); got.ReasoningProtocol != "" || len(got.SupportedEfforts) != 0 {
+		t.Fatal("expired facts survived re-resolution")
+	}
+}
+
+func TestDiscoveredReasoningNeverInventsLevelsOrBreaksFixedProtocols(t *testing.T) {
+	t.Setenv("REASONIX_HOME", t.TempDir())
+	for _, r := range []*provider.ModelReasoningInfo{{Parameter: true}, {Protocol: "glm", Efforts: []string{"low", "high"}}, {Protocol: "kimi-k3", Efforts: []string{"medium"}}} {
+		e := ProviderEntry{Name: "relay", Kind: "openai", BaseURL: "https://relay.test", Model: "custom-model"}
+		e.ApplyDiscoveredReasoning([]provider.ModelInfo{{ID: e.Model, ReasoningInfo: r}})
+		got := ResolveReasoningEntry(&e)
+		if len(got.SupportedEfforts) != 0 || got.ReasoningProtocol != "" {
+			t.Fatalf("unsafe declaration applied: %+v", got)
+		}
+	}
+}
diff --git a/internal/config/model_limits.go b/internal/config/model_limits.go
new file mode 100644
index 0000000000000000000000000000000000000000..fb1c34f8f190b1e7e8d5e3376d67cccaf692e4bf
--- /dev/null
+++ b/internal/config/model_limits.go
@@ -0,0 +1,103 @@
+package config
+
+import (
+	"errors"
+	"strings"
+)
+
+// ErrModelContextWindowNegative refuses a per-model window below zero. Zero is
+// how a model inherits its connection's window, so a negative value has no
+// meaning to fall back to.
+var ErrModelContextWindowNegative = errors.New("a model's context window cannot be negative")
+
+// ModelLimits is what one model declares for itself on a connection whose
+// models do not share the same budgets. Zero inherits; a negative output cap is
+// the stored spelling of "send no cap" and is kept exactly as written.
+type ModelLimits struct {
+	ContextWindow   int
+	MaxOutputTokens int
+}
+
+// ModelLimits reports the limits stored for model itself. The bool is false
+// when the model declares none and inherits both, which is different from
+// declaring zero-sized limits.
+func (e *ProviderEntry) ModelLimits(model string) (ModelLimits, bool) {
+	ov, ok := e.modelOverrideForModel(model)
+	if !ok || (ov.ContextWindow <= 0 && ov.MaxOutputTokens == 0) {
+		return ModelLimits{}, false
+	}
+	return ModelLimits{ContextWindow: max(ov.ContextWindow, 0), MaxOutputTokens: ov.MaxOutputTokens}, true
+}
+
+// SetModelLimits stores limits for model, or clears them when both are zero so
+// the model inherits again. Every other field of that model's override — its
+// reasoning protocol, effort ladder, vision flag — is preserved.
+func (e *ProviderEntry) SetModelLimits(model string, limits ModelLimits) error {
+	model = strings.TrimSpace(model)
+	if e == nil || model == "" {
+		return nil
+	}
+	if limits.ContextWindow < 0 {
+		return ErrModelContextWindowNegative
+	}
+	key := e.storedModelOverrideKey(model)
+	ov := e.ModelOverrides[key]
+	ov.ContextWindow, ov.MaxOutputTokens = limits.ContextWindow, limits.MaxOutputTokens
+	if modelOverrideEmpty(ov) {
+		delete(e.ModelOverrides, key)
+		if len(e.ModelOverrides) == 0 {
+			e.ModelOverrides = nil
+		}
+		return nil
+	}
+	if e.ModelOverrides == nil {
+		e.ModelOverrides = map[string]ProviderModelOverride{}
+	}
+	e.ModelOverrides[key] = ov
+	return nil
+}
+
+// InheritedLimits is what model runs on when it declares no limits: the entry
+// resolved onto that model with only those two fields of its override removed.
+// Surfaces that show a blank field next to an inherited value use it, so a
+// blank means the number displayed rather than an unknown.
+func (e *ProviderEntry) InheritedLimits(model string) ModelLimits {
+	if e == nil {
+		return ModelLimits{}
+	}
+	cp := *e
+	cp.Model = strings.TrimSpace(model)
+	if key := cp.storedModelOverrideKey(cp.Model); key != "" {
+		if _, ok := cp.ModelOverrides[key]; ok {
+			overrides := make(map[string]ProviderModelOverride, len(cp.ModelOverrides))
+			for k, v := range cp.ModelOverrides {
+				overrides[k] = v
+			}
+			ov := overrides[key]
+			ov.ContextWindow, ov.MaxOutputTokens = 0, 0
+			overrides[key] = ov
+			cp.ModelOverrides = overrides
+		}
+	}
+	resolved := ResolveReasoningEntry(&cp)
+	return ModelLimits{ContextWindow: resolved.ContextWindow, MaxOutputTokens: resolved.MaxOutputTokens}
+}
+
+// storedModelOverrideKey is the key a new or existing override for model is
+// stored under: the existing key when one matches case-insensitively, so an
+// edit never leaves the model declared twice, else the trimmed id itself.
+func (e *ProviderEntry) storedModelOverrideKey(model string) string {
+	model = strings.TrimSpace(model)
+	if e == nil || model == "" {
+		return model
+	}
+	if _, ok := e.ModelOverrides[model]; ok {
+		return model
+	}
+	for key := range e.ModelOverrides {
+		if strings.EqualFold(strings.TrimSpace(key), model) {
+			return key
+		}
+	}
+	return model
+}
diff --git a/internal/config/model_limits_discovery.go b/internal/config/model_limits_discovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..47c8e37946a7f3af6ef6e7c4f6fa7c9d1ef6397a
--- /dev/null
+++ b/internal/config/model_limits_discovery.go
@@ -0,0 +1,62 @@
+package config
+
+import (
+	"strings"
+
+	"reasonix/internal/provider"
+)
+
+// ApplyDiscoveredLimits writes what a model listing declared about each
+// selected model into this entry's per-model overrides, and reports how many
+// models it filled in.
+//
+// It only fills gaps. A window the user already declared — per model or for the
+// whole connection — is left exactly as written, because a listing is the
+// endpoint's claim and the configuration is the person's answer. An endpoint
+// that reports no capacity for a model leaves that model inheriting, which is
+// the same state it was in before the call.
+func (e *ProviderEntry) ApplyDiscoveredLimits(catalog []provider.ModelInfo) int {
+	if e == nil || len(catalog) == 0 {
+		return 0
+	}
+	discovered := make(map[string]provider.ModelInfo, len(catalog))
+	for _, info := range catalog {
+		if id := strings.TrimSpace(info.ID); id != "" {
+			discovered[id] = info
+		}
+	}
+	filled := 0
+	for _, model := range e.ModelList() {
+		info, ok := discovered[strings.TrimSpace(model)]
+		if !ok || (info.ContextWindow <= 0 && info.MaxOutputTokens <= 0) {
+			continue
+		}
+		existing, declared := e.ModelLimits(model)
+		if declared && existing.ContextWindow > 0 {
+			// The model already states its own window; discovery adds nothing.
+			continue
+		}
+		// A connection-wide window is the person's answer for every model it
+		// covers, so a listing must not quietly replace it with per-model
+		// overrides. Only a model that inherits nothing (no connection window and
+		// no own window) has a real gap to fill.
+		if !declared && e.ContextWindow > 0 && info.ContextWindow > 0 {
+			continue
+		}
+		next := existing
+		if info.ContextWindow > 0 {
+			next.ContextWindow = info.ContextWindow
+		}
+		if info.MaxOutputTokens > 0 && next.MaxOutputTokens == 0 {
+			next.MaxOutputTokens = info.MaxOutputTokens
+		}
+		if next == existing {
+			continue
+		}
+		if err := e.SetModelLimits(model, next); err != nil {
+			continue
+		}
+		filled++
+	}
+	return filled
+}
diff --git a/internal/config/model_limits_test.go b/internal/config/model_limits_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a410bba5480c3e3effbf5fcc74b68f355c9da336
--- /dev/null
+++ b/internal/config/model_limits_test.go
@@ -0,0 +1,146 @@
+package config
+
+import (
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// The stored limits are per model, so setting one never disturbs another
+// model's reasoning ladder or vision flag on the same connection.
+func TestSetModelLimitsPreservesTheRestOfTheOverride(t *testing.T) {
+	vision := true
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models: []string{"a", "b"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ReasoningProtocol: "deepseek", SupportedEfforts: []string{"low", "high"}, Vision: &vision},
+			"b": {ContextWindow: 32_000},
+		},
+	}
+	if err := entry.SetModelLimits("a", ModelLimits{ContextWindow: 128_000, MaxOutputTokens: 8_192}); err != nil {
+		t.Fatal(err)
+	}
+	kept := entry.ModelOverrides["a"]
+	if kept.ReasoningProtocol != "deepseek" || len(kept.SupportedEfforts) != 2 || kept.Vision == nil || !*kept.Vision {
+		t.Fatalf("unrelated fields were dropped: %+v", kept)
+	}
+	if kept.ContextWindow != 128_000 || kept.MaxOutputTokens != 8_192 {
+		t.Fatalf("limits not stored: %+v", kept)
+	}
+	if entry.ModelOverrides["b"].ContextWindow != 32_000 {
+		t.Fatal("another model's limits changed")
+	}
+}
+
+// Clearing both limits removes the override so the model inherits again, and an
+// override that still carries other declarations is kept rather than deleted.
+func TestSetModelLimitsClearsByInheriting(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai", Models: []string{"a", "b"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ContextWindow: 1_000},
+			"b": {ContextWindow: 2_000, ReasoningProtocol: "deepseek"},
+		},
+	}
+	if err := entry.SetModelLimits("a", ModelLimits{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := entry.ModelOverrides["a"]; ok {
+		t.Fatal("cleared override survived")
+	}
+	if err := entry.SetModelLimits("b", ModelLimits{}); err != nil {
+		t.Fatal(err)
+	}
+	if entry.ModelOverrides["b"].ReasoningProtocol != "deepseek" {
+		t.Fatal("clearing limits discarded the reasoning declaration")
+	}
+	if _, ok := entry.ModelLimits("b"); ok {
+		t.Fatal("cleared limits still report themselves as declared")
+	}
+}
+
+// A negative window has nothing to mean, so it is refused instead of silently
+// reinterpreted as "inherit".
+func TestSetModelLimitsRefusesANegativeWindow(t *testing.T) {
+	entry := &ProviderEntry{Name: "relay", Kind: "openai", Models: []string{"a"}}
+	if err := entry.SetModelLimits("a", ModelLimits{ContextWindow: -1}); err == nil {
+		t.Fatal("negative window accepted")
+	}
+}
+
+// InheritedLimits is what a blank field on a settings form means, so it must
+// report the connection's value with the model's own limits taken back out.
+func TestInheritedLimitsDropsOnlyTheModelsOwnLimits(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai", Models: []string{"a"},
+		ContextWindow: 200_000, MaxOutputTokens: 4_096,
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ContextWindow: 64_000, MaxOutputTokens: 1_024},
+		},
+	}
+	if got := entry.InheritedLimits("a"); got.ContextWindow != 200_000 || got.MaxOutputTokens != 4_096 {
+		t.Fatalf("inherited = %+v, want the connection's 200000/4096", got)
+	}
+	if limits, ok := entry.ModelLimits("a"); !ok || limits.ContextWindow != 64_000 {
+		t.Fatalf("stored limits = %+v ok=%v", limits, ok)
+	}
+}
+
+// Discovery fills only gaps: a window the person declared is their answer, and
+// a model the listing said nothing about stays inheriting.
+func TestApplyDiscoveredLimitsFillsOnlyGaps(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models: []string{"known", "declared", "silent"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"declared": {ContextWindow: 64_000},
+		},
+	}
+	catalog := []provider.ModelInfo{
+		{ID: "known", ContextWindow: 1_000_000, MaxOutputTokens: 131_072},
+		{ID: "declared", ContextWindow: 128_000},
+		{ID: "silent"},
+	}
+	if filled := entry.ApplyDiscoveredLimits(catalog); filled != 1 {
+		t.Fatalf("filled = %d, want only the model that had no window", filled)
+	}
+	known, ok := entry.ModelLimits("known")
+	if !ok || known.ContextWindow != 1_000_000 || known.MaxOutputTokens != 131_072 {
+		t.Fatalf("discovered limits = %+v ok=%v", known, ok)
+	}
+	if entry.ModelOverrides["declared"].ContextWindow != 64_000 {
+		t.Fatal("a declared window was overwritten by the listing")
+	}
+	if _, ok := entry.ModelLimits("silent"); ok {
+		t.Fatal("a model the listing said nothing about gained limits")
+	}
+}
+
+// A connection-wide window is the person's answer for every model it covers, so
+// a listing must not quietly replace it with per-model overrides. Only a model
+// that inherits nothing has a real gap for discovery to fill.
+func TestApplyDiscoveredLimitsRespectsAConnectionWindow(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models:        []string{"m", "n"},
+		ContextWindow: 128_000,
+	}
+	catalog := []provider.ModelInfo{
+		{ID: "m", ContextWindow: 1_000_000},
+		{ID: "n", ContextWindow: 500_000},
+	}
+	if filled := entry.ApplyDiscoveredLimits(catalog); filled != 0 {
+		t.Fatalf("discovery wrote %d overrides over a connection window: %+v", filled, entry.ModelOverrides)
+	}
+	if _, ok := entry.ModelLimits("m"); ok {
+		t.Fatal("a model gained an override despite the connection-wide window")
+	}
+
+	// With no connection window the models do inherit nothing, so the gap is
+	// real and must still be filled.
+	bare := &ProviderEntry{Name: "relay", Kind: "openai", Models: []string{"m"}}
+	if filled := bare.ApplyDiscoveredLimits(catalog); filled != 1 {
+		t.Fatalf("a real gap was not filled: %d", filled)
+	}
+}
