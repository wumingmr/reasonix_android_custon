diff --git a/internal/agent/context_window_probe.go b/internal/agent/context_window_probe.go
new file mode 100644
index 0000000000000000000000000000000000000000..ed518617413aa18c11508cbe225465b319e6aba7
--- /dev/null
+++ b/internal/agent/context_window_probe.go
@@ -0,0 +1,129 @@
+package agent
+
+import (
+	"sync/atomic"
+
+	"reasonix/internal/provider"
+)
+
+// contextWindowProbe is what an endpoint that declares no usable window still
+// tells us about it, measured from requests this agent actually sent: the
+// smallest prompt it refused as too long, and the largest prompt it accepted
+// afterwards. A refusal states a ceiling nobody can exceed; an accepted prompt
+// states a size that did reach the model. Together they bound the real window
+// instead of guessing at one.
+//
+// The Agent's learnedContextBudget already adopts the window a refusal names.
+// This probe exists because that number is only the provider's report: relays
+// commonly answer with the ceiling of the route rather than of the model, and
+// a window adopted from it alone can be as wrong as no window at all. An
+// accepted measurement taken after the refusal is the only observation that
+// distinguishes the two.
+//
+// The zero value is ready to use, because an Agent must never carry a window
+// nobody established.
+type contextWindowProbe struct {
+	rejected promptTokenExtreme
+	// accepted is only written once a refusal established what does not fit.
+	// An accepted prompt before that says nothing about the ceiling — it is a
+	// turn that happened to be short — and adopting it as a window would
+	// compact away almost the whole conversation.
+	accepted promptTokenExtreme
+	// refused marks that a refusal has happened, so the accepted side stays
+	// dormant until then.
+	refused atomic.Bool
+}
+
+// promptTokenExtreme tracks one end of a sequence of token counts. Zero is the
+// empty state, so a caller reads get() == 0 as "nothing observed".
+type promptTokenExtreme struct {
+	value atomic.Int64
+}
+
+// noteMin records tokens when it is smaller than what is already known.
+func (t *promptTokenExtreme) noteMin(tokens int) {
+	if t == nil || tokens <= 0 {
+		return
+	}
+	next := int64(tokens)
+	for {
+		current := t.value.Load()
+		if current != 0 && next >= current {
+			return
+		}
+		if t.value.CompareAndSwap(current, next) {
+			return
+		}
+	}
+}
+
+// noteMax records tokens when it is larger than what is already known.
+func (t *promptTokenExtreme) noteMax(tokens int) {
+	if t == nil || tokens <= 0 {
+		return
+	}
+	next := int64(tokens)
+	for {
+		current := t.value.Load()
+		if current != 0 && next <= current {
+			return
+		}
+		if t.value.CompareAndSwap(current, next) {
+			return
+		}
+	}
+}
+
+func (t *promptTokenExtreme) get() int {
+	if t == nil {
+		return 0
+	}
+	return int(t.value.Load())
+}
+
+// noteRejectedPromptTokens records a prompt the provider refused as too long.
+func (a *Agent) noteRejectedPromptTokens(tokens int) {
+	if a == nil {
+		return
+	}
+	a.windowProbe.rejected.noteMin(tokens)
+	a.windowProbe.refused.Store(true)
+}
+
+// noteAcceptedPromptTokens records a provider-counted prompt size that reached
+// the model. It applies the same trust rule as prompt calibration: an estimate
+// is our own arithmetic and may not become a measurement.
+func (a *Agent) noteAcceptedPromptTokens(usage *provider.Usage) {
+	if a == nil || usage == nil || usage.Estimated || !a.windowProbe.refused.Load() {
+		return
+	}
+	a.windowProbe.accepted.noteMax(usage.LatestPromptTokens())
+}
+
+// probedWindow is the window the probe establishes, or zero while it has
+// established nothing. Zero means "no evidence", which leaves the configured
+// window — including the conservative fallback — in charge.
+//
+// The accepted bound wins when it exists: it is the only size known to have
+// fit. The refused size stands in until such a measurement arrives, because a
+// prompt the provider just rejected is a bound it cannot exceed either way.
+func (a *Agent) probedWindow() int {
+	if a == nil || !a.windowProbe.refused.Load() {
+		return 0
+	}
+	rejected := a.windowProbe.rejected.get()
+	if rejected <= 0 {
+		return 0
+	}
+	if accepted := a.windowProbe.accepted.get(); accepted > 0 && accepted < rejected {
+		return accepted
+	}
+	return rejected
+}
+
+// minProbeWindowTokens is the smallest window a measurement is allowed to
+// establish. Below it, no fold can be summarized into something the window
+// holds, so adopting the number would leave every later turn unserviceable
+// rather than merely conservative. It matches the floor the summary planner
+// works with, expressed once here so the two cannot drift apart.
+const minProbeWindowTokens = 8 * 1024
diff --git a/internal/agent/context_window_probe_test.go b/internal/agent/context_window_probe_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d707373933b1b30886f79fb5b220f384ad6fb1c4
--- /dev/null
+++ b/internal/agent/context_window_probe_test.go
@@ -0,0 +1,110 @@
+package agent
+
+import (
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// An accepted prompt on its own says nothing about the ceiling: it is a turn
+// that happened to be short. Adopting it as the window would compact away
+// almost the whole conversation, so the probe stays silent until something was
+// actually refused.
+func TestProbeIgnoresAcceptedPromptsBeforeAnyRefusal(t *testing.T) {
+	a := &Agent{}
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 1_200})
+	if got := a.probedWindow(); got != 0 {
+		t.Fatalf("window = %d without a refusal, want no bound", got)
+	}
+	if got := a.effectiveContextWindow(); got != 0 {
+		t.Fatalf("effective window = %d, want the configured zero", got)
+	}
+}
+
+// The refused size is the first bound: the provider said a prompt that large
+// does not fit, so nothing bigger runs. It stands until a fitted measurement
+// arrives.
+func TestProbeAdoptsTheRefusedSizeAsABound(t *testing.T) {
+	a := &Agent{}
+	a.noteRejectedPromptTokens(900_000)
+	if got := a.probedWindow(); got != 900_000 {
+		t.Fatalf("window = %d, want the refused 900000", got)
+	}
+	// A smaller refusal is a tighter bound; a larger one cannot be, since the
+	// smaller prompt already failed.
+	a.noteRejectedPromptTokens(700_000)
+	a.noteRejectedPromptTokens(800_000)
+	if got := a.probedWindow(); got != 700_000 {
+		t.Fatalf("window = %d, want the smallest refusal 700000", got)
+	}
+}
+
+// The measurement that distinguishes a route-wide ceiling from the model's own
+// is a prompt that fit after a refusal: that is the only size known to work.
+func TestProbePrefersTheLargestAcceptedPromptAfterARefusal(t *testing.T) {
+	a := &Agent{}
+	a.noteRejectedPromptTokens(900_000)
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 400_000})
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 600_000})
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 500_000})
+	if got := a.probedWindow(); got != 600_000 {
+		t.Fatalf("window = %d, want the largest accepted 600000", got)
+	}
+	// An accepted prompt at or above the refusal contradicts it and must not
+	// raise the bound: the refusal already proved that size does not fit.
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 950_000})
+	if got := a.probedWindow(); got != 900_000 {
+		t.Fatalf("window = %d, an accepted prompt above the refusal raised the bound", got)
+	}
+
+	// Smaller accepted prompts keep the largest reachable size: 600000 is known
+	// to have fit, while the refusal only says 900000 did not.
+	smaller := &Agent{}
+	smaller.noteRejectedPromptTokens(900_000)
+	smaller.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 700_000})
+	if got := smaller.probedWindow(); got != 700_000 {
+		t.Fatalf("window = %d, want the accepted 700000", got)
+	}
+}
+
+// Estimates are our own arithmetic and never become measurements.
+func TestProbeIgnoresEstimatedUsage(t *testing.T) {
+	a := &Agent{}
+	a.noteRejectedPromptTokens(900_000)
+	a.noteAcceptedPromptTokens(&provider.Usage{PromptTokens: 100, Estimated: true})
+	if got := a.probedWindow(); got != 900_000 {
+		t.Fatalf("window = %d, an estimate was adopted as a measurement", got)
+	}
+}
+
+// The probe never overrides the window the run was started with: that number
+// already came from the configuration, the model catalog or the fallback, and
+// the recovery ladder tightens it deliberately. The probe only reports what it
+// measured, for surfaces that show where a bound came from.
+func TestProbeNeverOverridesTheConfiguredWindow(t *testing.T) {
+	a := &Agent{}
+	a.contextWindow = 1_048_576
+	a.noteRejectedPromptTokens(400_000)
+	if got := a.effectiveContextWindow(); got != 1_048_576 {
+		t.Fatalf("window = %d, the probe overrode the configured window", got)
+	}
+	if got := a.probedWindow(); got != 400_000 {
+		t.Fatalf("probed window = %d, want the measured 400000", got)
+	}
+}
+
+// A measurement too small to hold even one fold is reported but never adopted:
+// a window nothing can be summarized into is worse than an honest unknown.
+func TestAMeasurementBelowTheFoldFloorIsNotAWindow(t *testing.T) {
+	if probed := minProbeWindowTokens - 1; probed <= 0 {
+		t.Fatal("probe floor must be positive")
+	}
+	a := &Agent{}
+	a.noteRejectedPromptTokens(minProbeWindowTokens - 1)
+	if got := a.probedWindow(); got <= 0 {
+		t.Fatalf("probed window = %d, the measurement should still be reported", got)
+	}
+	if got := a.probedWindow(); got >= minProbeWindowTokens {
+		t.Fatalf("probed window = %d, a sub-floor measurement must not reach the floor", got)
+	}
+}
