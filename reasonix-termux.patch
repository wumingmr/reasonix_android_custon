diff --git a/internal/config/model_limits.go b/internal/config/model_limits.go
new file mode 100644
index 0000000000000000000000000000000000000000..fb1c34f8f190b1e7e8d5e3376d67cccaf692e4bf
--- /dev/null
+++ b/internal/config/model_limits.go
@@ -0,0 +1,103 @@
+package config
+
+import (
+	"errors"
+	"strings"
+)
+
+// ErrModelContextWindowNegative refuses a per-model window below zero. Zero is
+// how a model inherits its connection's window, so a negative value has no
+// meaning to fall back to.
+var ErrModelContextWindowNegative = errors.New("a model's context window cannot be negative")
+
+// ModelLimits is what one model declares for itself on a connection whose
+// models do not share the same budgets. Zero inherits; a negative output cap is
+// the stored spelling of "send no cap" and is kept exactly as written.
+type ModelLimits struct {
+	ContextWindow   int
+	MaxOutputTokens int
+}
+
+// ModelLimits reports the limits stored for model itself. The bool is false
+// when the model declares none and inherits both, which is different from
+// declaring zero-sized limits.
+func (e *ProviderEntry) ModelLimits(model string) (ModelLimits, bool) {
+	ov, ok := e.modelOverrideForModel(model)
+	if !ok || (ov.ContextWindow <= 0 && ov.MaxOutputTokens == 0) {
+		return ModelLimits{}, false
+	}
+	return ModelLimits{ContextWindow: max(ov.ContextWindow, 0), MaxOutputTokens: ov.MaxOutputTokens}, true
+}
+
+// SetModelLimits stores limits for model, or clears them when both are zero so
+// the model inherits again. Every other field of that model's override — its
+// reasoning protocol, effort ladder, vision flag — is preserved.
+func (e *ProviderEntry) SetModelLimits(model string, limits ModelLimits) error {
+	model = strings.TrimSpace(model)
+	if e == nil || model == "" {
+		return nil
+	}
+	if limits.ContextWindow < 0 {
+		return ErrModelContextWindowNegative
+	}
+	key := e.storedModelOverrideKey(model)
+	ov := e.ModelOverrides[key]
+	ov.ContextWindow, ov.MaxOutputTokens = limits.ContextWindow, limits.MaxOutputTokens
+	if modelOverrideEmpty(ov) {
+		delete(e.ModelOverrides, key)
+		if len(e.ModelOverrides) == 0 {
+			e.ModelOverrides = nil
+		}
+		return nil
+	}
+	if e.ModelOverrides == nil {
+		e.ModelOverrides = map[string]ProviderModelOverride{}
+	}
+	e.ModelOverrides[key] = ov
+	return nil
+}
+
+// InheritedLimits is what model runs on when it declares no limits: the entry
+// resolved onto that model with only those two fields of its override removed.
+// Surfaces that show a blank field next to an inherited value use it, so a
+// blank means the number displayed rather than an unknown.
+func (e *ProviderEntry) InheritedLimits(model string) ModelLimits {
+	if e == nil {
+		return ModelLimits{}
+	}
+	cp := *e
+	cp.Model = strings.TrimSpace(model)
+	if key := cp.storedModelOverrideKey(cp.Model); key != "" {
+		if _, ok := cp.ModelOverrides[key]; ok {
+			overrides := make(map[string]ProviderModelOverride, len(cp.ModelOverrides))
+			for k, v := range cp.ModelOverrides {
+				overrides[k] = v
+			}
+			ov := overrides[key]
+			ov.ContextWindow, ov.MaxOutputTokens = 0, 0
+			overrides[key] = ov
+			cp.ModelOverrides = overrides
+		}
+	}
+	resolved := ResolveReasoningEntry(&cp)
+	return ModelLimits{ContextWindow: resolved.ContextWindow, MaxOutputTokens: resolved.MaxOutputTokens}
+}
+
+// storedModelOverrideKey is the key a new or existing override for model is
+// stored under: the existing key when one matches case-insensitively, so an
+// edit never leaves the model declared twice, else the trimmed id itself.
+func (e *ProviderEntry) storedModelOverrideKey(model string) string {
+	model = strings.TrimSpace(model)
+	if e == nil || model == "" {
+		return model
+	}
+	if _, ok := e.ModelOverrides[model]; ok {
+		return model
+	}
+	for key := range e.ModelOverrides {
+		if strings.EqualFold(strings.TrimSpace(key), model) {
+			return key
+		}
+	}
+	return model
+}
diff --git a/internal/config/model_limits_discovery.go b/internal/config/model_limits_discovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..47c8e37946a7f3af6ef6e7c4f6fa7c9d1ef6397a
--- /dev/null
+++ b/internal/config/model_limits_discovery.go
@@ -0,0 +1,62 @@
+package config
+
+import (
+	"strings"
+
+	"reasonix/internal/provider"
+)
+
+// ApplyDiscoveredLimits writes what a model listing declared about each
+// selected model into this entry's per-model overrides, and reports how many
+// models it filled in.
+//
+// It only fills gaps. A window the user already declared — per model or for the
+// whole connection — is left exactly as written, because a listing is the
+// endpoint's claim and the configuration is the person's answer. An endpoint
+// that reports no capacity for a model leaves that model inheriting, which is
+// the same state it was in before the call.
+func (e *ProviderEntry) ApplyDiscoveredLimits(catalog []provider.ModelInfo) int {
+	if e == nil || len(catalog) == 0 {
+		return 0
+	}
+	discovered := make(map[string]provider.ModelInfo, len(catalog))
+	for _, info := range catalog {
+		if id := strings.TrimSpace(info.ID); id != "" {
+			discovered[id] = info
+		}
+	}
+	filled := 0
+	for _, model := range e.ModelList() {
+		info, ok := discovered[strings.TrimSpace(model)]
+		if !ok || (info.ContextWindow <= 0 && info.MaxOutputTokens <= 0) {
+			continue
+		}
+		existing, declared := e.ModelLimits(model)
+		if declared && existing.ContextWindow > 0 {
+			// The model already states its own window; discovery adds nothing.
+			continue
+		}
+		// A connection-wide window is the person's answer for every model it
+		// covers, so a listing must not quietly replace it with per-model
+		// overrides. Only a model that inherits nothing (no connection window and
+		// no own window) has a real gap to fill.
+		if !declared && e.ContextWindow > 0 && info.ContextWindow > 0 {
+			continue
+		}
+		next := existing
+		if info.ContextWindow > 0 {
+			next.ContextWindow = info.ContextWindow
+		}
+		if info.MaxOutputTokens > 0 && next.MaxOutputTokens == 0 {
+			next.MaxOutputTokens = info.MaxOutputTokens
+		}
+		if next == existing {
+			continue
+		}
+		if err := e.SetModelLimits(model, next); err != nil {
+			continue
+		}
+		filled++
+	}
+	return filled
+}
diff --git a/internal/config/model_limits_test.go b/internal/config/model_limits_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a410bba5480c3e3effbf5fcc74b68f355c9da336
--- /dev/null
+++ b/internal/config/model_limits_test.go
@@ -0,0 +1,146 @@
+package config
+
+import (
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// The stored limits are per model, so setting one never disturbs another
+// model's reasoning ladder or vision flag on the same connection.
+func TestSetModelLimitsPreservesTheRestOfTheOverride(t *testing.T) {
+	vision := true
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models: []string{"a", "b"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ReasoningProtocol: "deepseek", SupportedEfforts: []string{"low", "high"}, Vision: &vision},
+			"b": {ContextWindow: 32_000},
+		},
+	}
+	if err := entry.SetModelLimits("a", ModelLimits{ContextWindow: 128_000, MaxOutputTokens: 8_192}); err != nil {
+		t.Fatal(err)
+	}
+	kept := entry.ModelOverrides["a"]
+	if kept.ReasoningProtocol != "deepseek" || len(kept.SupportedEfforts) != 2 || kept.Vision == nil || !*kept.Vision {
+		t.Fatalf("unrelated fields were dropped: %+v", kept)
+	}
+	if kept.ContextWindow != 128_000 || kept.MaxOutputTokens != 8_192 {
+		t.Fatalf("limits not stored: %+v", kept)
+	}
+	if entry.ModelOverrides["b"].ContextWindow != 32_000 {
+		t.Fatal("another model's limits changed")
+	}
+}
+
+// Clearing both limits removes the override so the model inherits again, and an
+// override that still carries other declarations is kept rather than deleted.
+func TestSetModelLimitsClearsByInheriting(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai", Models: []string{"a", "b"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ContextWindow: 1_000},
+			"b": {ContextWindow: 2_000, ReasoningProtocol: "deepseek"},
+		},
+	}
+	if err := entry.SetModelLimits("a", ModelLimits{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := entry.ModelOverrides["a"]; ok {
+		t.Fatal("cleared override survived")
+	}
+	if err := entry.SetModelLimits("b", ModelLimits{}); err != nil {
+		t.Fatal(err)
+	}
+	if entry.ModelOverrides["b"].ReasoningProtocol != "deepseek" {
+		t.Fatal("clearing limits discarded the reasoning declaration")
+	}
+	if _, ok := entry.ModelLimits("b"); ok {
+		t.Fatal("cleared limits still report themselves as declared")
+	}
+}
+
+// A negative window has nothing to mean, so it is refused instead of silently
+// reinterpreted as "inherit".
+func TestSetModelLimitsRefusesANegativeWindow(t *testing.T) {
+	entry := &ProviderEntry{Name: "relay", Kind: "openai", Models: []string{"a"}}
+	if err := entry.SetModelLimits("a", ModelLimits{ContextWindow: -1}); err == nil {
+		t.Fatal("negative window accepted")
+	}
+}
+
+// InheritedLimits is what a blank field on a settings form means, so it must
+// report the connection's value with the model's own limits taken back out.
+func TestInheritedLimitsDropsOnlyTheModelsOwnLimits(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai", Models: []string{"a"},
+		ContextWindow: 200_000, MaxOutputTokens: 4_096,
+		ModelOverrides: map[string]ProviderModelOverride{
+			"a": {ContextWindow: 64_000, MaxOutputTokens: 1_024},
+		},
+	}
+	if got := entry.InheritedLimits("a"); got.ContextWindow != 200_000 || got.MaxOutputTokens != 4_096 {
+		t.Fatalf("inherited = %+v, want the connection's 200000/4096", got)
+	}
+	if limits, ok := entry.ModelLimits("a"); !ok || limits.ContextWindow != 64_000 {
+		t.Fatalf("stored limits = %+v ok=%v", limits, ok)
+	}
+}
+
+// Discovery fills only gaps: a window the person declared is their answer, and
+// a model the listing said nothing about stays inheriting.
+func TestApplyDiscoveredLimitsFillsOnlyGaps(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models: []string{"known", "declared", "silent"},
+		ModelOverrides: map[string]ProviderModelOverride{
+			"declared": {ContextWindow: 64_000},
+		},
+	}
+	catalog := []provider.ModelInfo{
+		{ID: "known", ContextWindow: 1_000_000, MaxOutputTokens: 131_072},
+		{ID: "declared", ContextWindow: 128_000},
+		{ID: "silent"},
+	}
+	if filled := entry.ApplyDiscoveredLimits(catalog); filled != 1 {
+		t.Fatalf("filled = %d, want only the model that had no window", filled)
+	}
+	known, ok := entry.ModelLimits("known")
+	if !ok || known.ContextWindow != 1_000_000 || known.MaxOutputTokens != 131_072 {
+		t.Fatalf("discovered limits = %+v ok=%v", known, ok)
+	}
+	if entry.ModelOverrides["declared"].ContextWindow != 64_000 {
+		t.Fatal("a declared window was overwritten by the listing")
+	}
+	if _, ok := entry.ModelLimits("silent"); ok {
+		t.Fatal("a model the listing said nothing about gained limits")
+	}
+}
+
+// A connection-wide window is the person's answer for every model it covers, so
+// a listing must not quietly replace it with per-model overrides. Only a model
+// that inherits nothing has a real gap for discovery to fill.
+func TestApplyDiscoveredLimitsRespectsAConnectionWindow(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Models:        []string{"m", "n"},
+		ContextWindow: 128_000,
+	}
+	catalog := []provider.ModelInfo{
+		{ID: "m", ContextWindow: 1_000_000},
+		{ID: "n", ContextWindow: 500_000},
+	}
+	if filled := entry.ApplyDiscoveredLimits(catalog); filled != 0 {
+		t.Fatalf("discovery wrote %d overrides over a connection window: %+v", filled, entry.ModelOverrides)
+	}
+	if _, ok := entry.ModelLimits("m"); ok {
+		t.Fatal("a model gained an override despite the connection-wide window")
+	}
+
+	// With no connection window the models do inherit nothing, so the gap is
+	// real and must still be filled.
+	bare := &ProviderEntry{Name: "relay", Kind: "openai", Models: []string{"m"}}
+	if filled := bare.ApplyDiscoveredLimits(catalog); filled != 1 {
+		t.Fatalf("a real gap was not filled: %d", filled)
+	}
+}
diff --git a/internal/config/model_window.go b/internal/config/model_window.go
new file mode 100644
index 0000000000000000000000000000000000000000..8c9c91810c53f7ec7fba7085cdbe7aa2fedde772
--- /dev/null
+++ b/internal/config/model_window.go
@@ -0,0 +1,157 @@
+package config
+
+// Where a model's context window comes from, and what happens when nothing
+// establishes one. The window is a fact about the model rather than about who
+// serves it, but it was only ever recorded per configured entry — so a source
+// added by hand resolved to nothing, and a zero window turns compaction off.
+// A session then grows until the provider refuses the request.
+
+// DefaultUnknownContextWindow is the conservative working window for a custom
+// endpoint that declares no capacity and serves a model nothing known about.
+// It is deliberately below the smallest window a modern chat model ships with:
+// too small only compacts earlier, while too large makes the provider reject
+// the request outright. Users replace it per model with a model_overrides
+// entry, or per connection with the provider's own context_window.
+const DefaultUnknownContextWindow = 128_000
+
+// ContextWindowSource names where a window came from. A single number cannot
+// say whether compaction fires early because the user asked for a small budget
+// or because nothing established the real one, and those two need opposite
+// fixes — so the origin travels with the value.
+type ContextWindowSource uint8
+
+const (
+	// ContextWindowUnestablished is the zero value: nothing said anything.
+	ContextWindowUnestablished ContextWindowSource = iota
+	// ContextWindowFromModelOverride is a model_overrides entry's context_window.
+	ContextWindowFromModelOverride
+	// ContextWindowFromProvider is the connection-wide context_window.
+	ContextWindowFromProvider
+	// ContextWindowFromModelCatalog is the window the built-in catalog records
+	// for the model itself, independent of who serves it.
+	ContextWindowFromModelCatalog
+	// ContextWindowFromFallback is DefaultUnknownContextWindow: a working value
+	// no source established.
+	ContextWindowFromFallback
+)
+
+// String is the stable token used by status surfaces and diagnostics. It is
+// not localised, because it also appears in machine-read output.
+func (s ContextWindowSource) String() string {
+	switch s {
+	case ContextWindowFromModelOverride:
+		return "model_override"
+	case ContextWindowFromProvider:
+		return "provider"
+	case ContextWindowFromModelCatalog:
+		return "model_catalog"
+	case ContextWindowFromFallback:
+		return "fallback"
+	default:
+		return "unestablished"
+	}
+}
+
+// IsEstablished reports whether a real source named this window, as opposed to
+// the fallback standing in for one nobody stated.
+func (s ContextWindowSource) IsEstablished() bool {
+	switch s {
+	case ContextWindowFromModelOverride, ContextWindowFromProvider, ContextWindowFromModelCatalog:
+		return true
+	default:
+		return false
+	}
+}
+
+// ResolvedWindow is a context window together with the source that named it.
+type ResolvedWindow struct {
+	Tokens int
+	Source ContextWindowSource
+}
+
+// Established reports whether a real source named this window.
+func (w ResolvedWindow) Established() bool { return w.Source.IsEstablished() }
+
+// ResolveContextWindow resolves the window to run this entry against and names
+// where it came from. Most-specific first: the per-model override, then the
+// connection-wide value, then what the built-in catalog knows about the model
+// itself. A caller that must not confuse "nobody said" with "no compaction
+// wanted" checks Established; everything else can use EffectiveContextWindow,
+// which also applies the fallback.
+func ResolveContextWindow(e *ProviderEntry) ResolvedWindow {
+	if e == nil {
+		return ResolvedWindow{}
+	}
+	if window, source := e.declaredContextWindow(); window > 0 {
+		return ResolvedWindow{Tokens: window, Source: source}
+	}
+	if window := builtinModelContextWindow(e); window > 0 {
+		return ResolvedWindow{Tokens: window, Source: ContextWindowFromModelCatalog}
+	}
+	return ResolvedWindow{}
+}
+
+// ResolvedContextWindow reports the window to run this entry against and
+// whether anything established it. It is ResolveContextWindow without the
+// origin, kept because most callers only branch on the second return.
+func ResolvedContextWindow(e *ProviderEntry) (int, bool) {
+	resolved := ResolveContextWindow(e)
+	return resolved.Tokens, resolved.Established()
+}
+
+// EffectiveContextWindow is the window a run must budget against: the declared
+// or known one, or the conservative fallback when nothing established it. It is
+// never zero, so it never silently disables compaction. A caller that
+// deliberately wants compaction off keeps checking the raw
+// ProviderEntry.ContextWindow instead.
+func EffectiveContextWindow(e *ProviderEntry) int {
+	return EffectiveResolvedWindow(e).Tokens
+}
+
+// EffectiveResolvedWindow is EffectiveContextWindow keeping the origin, which
+// surfaces use to explain the number instead of only printing it.
+func EffectiveResolvedWindow(e *ProviderEntry) ResolvedWindow {
+	resolved := ResolveContextWindow(e)
+	if resolved.Tokens > 0 {
+		return resolved
+	}
+	return ResolvedWindow{Tokens: DefaultUnknownContextWindow, Source: ContextWindowFromFallback}
+}
+
+// declaredContextWindow is what the configuration said for this exact model:
+// the per-model override first, then the connection-wide value. This ordering
+// matches applyModelOverride, which the entry normally went through already;
+// checking the override directly keeps the answer right for a raw
+// ProviderEntry that never did.
+func (e *ProviderEntry) declaredContextWindow() (int, ContextWindowSource) {
+	if e == nil {
+		return 0, ContextWindowUnestablished
+	}
+	if e.Model != "" {
+		if ov, ok := e.modelOverrideForModel(e.Model); ok && ov.ContextWindow > 0 {
+			return ov.ContextWindow, ContextWindowFromModelOverride
+		}
+	}
+	if e.ContextWindow > 0 {
+		// applyModelOverride already folded the override into ContextWindow, so an
+		// entry that went through resolution reports the same number under this
+		// branch. The override check above runs first for that reason.
+		return e.ContextWindow, ContextWindowFromProvider
+	}
+	return 0, ContextWindowUnestablished
+}
+
+// builtinModelContextWindow is what the compiled-in catalog knows about the
+// model itself, regardless of which gateway serves it. Only facts the catalog
+// actually states count: a model whose window nobody published stays unknown
+// instead of inheriting a guess from its family name.
+func builtinModelContextWindow(e *ProviderEntry) int {
+	if e == nil {
+		return 0
+	}
+	cap, ok := modelReasoningCapabilityForEntry(e)
+	if !ok || cap.ContextWindow <= 0 {
+		return 0
+	}
+	return cap.ContextWindow
+}
diff --git a/internal/config/model_window_test.go b/internal/config/model_window_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..36f763754913280846e9264301475150affa4415
--- /dev/null
+++ b/internal/config/model_window_test.go
@@ -0,0 +1,143 @@
+package config
+
+import "testing"
+
+// A relay added by hand records no window anywhere, and a zero window turns
+// compaction off. When the model itself is a known one, its own ceiling is the
+// answer, so the session is not left growing until the provider refuses it.
+func TestARelayInheritsTheWindowKnownForTheModel(t *testing.T) {
+	cfg := &Config{Providers: []ProviderEntry{{
+		Name: "relay", Kind: "openai", BaseURL: "https://relay.example.com/v1",
+		Models: []string{"deepseek-v4-pro"}, Default: "deepseek-v4-pro",
+	}}}
+	entry, ok := cfg.ResolveModel("relay/deepseek-v4-pro")
+	if !ok {
+		t.Fatal("relay model did not resolve")
+	}
+	if entry.ContextWindow != 0 {
+		t.Fatalf("entry carries a window %d nobody declared", entry.ContextWindow)
+	}
+	window, declared := ResolvedContextWindow(entry)
+	if !declared || window != 1_000_000 {
+		t.Fatalf("window = %d declared=%v, want the model's own ceiling", window, declared)
+	}
+}
+
+// Everything the configuration says outranks the built-in fact: the catalog is
+// the fallback for what nobody declared, not an override of what somebody did.
+func TestDeclaredWindowsOutrankTheModelCatalog(t *testing.T) {
+	resource := ProviderEntry{
+		Name: "relay", Kind: "openai", BaseURL: "https://relay.example.com/v1",
+		Models: []string{"deepseek-v4-pro"}, Default: "deepseek-v4-pro",
+		ContextWindow: 128_000,
+	}
+	cfg := &Config{Providers: []ProviderEntry{resource}}
+	entry, _ := cfg.ResolveModel("relay/deepseek-v4-pro")
+	if window, _ := ResolvedContextWindow(entry); window != 128_000 {
+		t.Fatalf("provider-wide window = %d, want the configured 128000", window)
+	}
+
+	cfg.Providers[0].ContextWindow = 0
+	cfg.Providers[0].ModelOverrides = map[string]ProviderModelOverride{
+		"deepseek-v4-pro": {ContextWindow: 64_000},
+	}
+	entry, _ = cfg.ResolveModel("relay/deepseek-v4-pro")
+	if window, _ := ResolvedContextWindow(entry); window != 64_000 {
+		t.Fatalf("per-model window = %d, want the configured 64000", window)
+	}
+}
+
+// Nothing established is not the same as "no compaction wanted". The fallback
+// keeps maintenance on for a relay serving a model nobody published numbers
+// for, while ResolvedContextWindow still reports that nobody said.
+func TestAnUnestablishedWindowFallsBackWithoutClaimingToKnow(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai", BaseURL: "https://relay.example.com/v1",
+		Model: "some-unlisted-model",
+	}
+	if window, declared := ResolvedContextWindow(entry); declared || window != 0 {
+		t.Fatalf("unestablished window reported as %d declared=%v", window, declared)
+	}
+	if window := EffectiveContextWindow(entry); window != DefaultUnknownContextWindow {
+		t.Fatalf("effective window = %d, want the %d fallback", window, DefaultUnknownContextWindow)
+	}
+}
+
+// The per-model override wins even on a raw entry that never went through
+// model resolution, which is how a settings surface reads a saved connection.
+func TestDeclaredContextWindowReadsTheOverrideDirectly(t *testing.T) {
+	entry := &ProviderEntry{
+		Name: "relay", Kind: "openai",
+		Model:         "deepseek-v4-pro",
+		ContextWindow: 200_000,
+		ModelOverrides: map[string]ProviderModelOverride{
+			"deepseek-v4-pro": {ContextWindow: 64_000},
+		},
+	}
+	window, source := entry.declaredContextWindow()
+	if window != 64_000 || source != ContextWindowFromModelOverride {
+		t.Fatalf("declared window = %d from %s, want the per-model 64000", window, source)
+	}
+}
+
+// The origin has to be named, because a window somebody chose and one nothing
+// established need opposite fixes. Most specific source wins.
+func TestResolveContextWindowNamesTheOrigin(t *testing.T) {
+	relay := ProviderEntry{
+		Name: "relay", Kind: "openai", BaseURL: "https://relay.example/v1",
+		Model: "deepseek-v4-pro",
+	}
+	if got := ResolveContextWindow(&relay); got.Tokens != 1_000_000 || got.Source != ContextWindowFromModelCatalog {
+		t.Fatalf("catalog window = %+v", got)
+	}
+
+	relay.ContextWindow = 200_000
+	if got := ResolveContextWindow(&relay); got.Tokens != 200_000 || got.Source != ContextWindowFromProvider {
+		t.Fatalf("provider window = %+v", got)
+	}
+
+	relay.ModelOverrides = map[string]ProviderModelOverride{"deepseek-v4-pro": {ContextWindow: 64_000}}
+	if got := ResolveContextWindow(&relay); got.Tokens != 64_000 || got.Source != ContextWindowFromModelOverride {
+		t.Fatalf("override window = %+v", got)
+	}
+
+	unknown := ProviderEntry{Name: "relay", Kind: "openai", Model: "some-unlisted-model"}
+	if got := ResolveContextWindow(&unknown); got.Tokens != 0 || got.Established() {
+		t.Fatalf("unestablished window = %+v", got)
+	}
+	if got := EffectiveResolvedWindow(&unknown); got.Tokens != DefaultUnknownContextWindow || got.Source != ContextWindowFromFallback {
+		t.Fatalf("fallback window = %+v", got)
+	}
+}
+
+// The fallback is a value nobody established, so it must never claim to be one:
+// a surface that showed it as the model's ceiling would send the user looking
+// for a limit that was never stated.
+func TestTheFallbackNeverClaimsToBeEstablished(t *testing.T) {
+	if ContextWindowFromFallback.IsEstablished() {
+		t.Fatal("the fallback reports itself as established")
+	}
+	for _, source := range []ContextWindowSource{ContextWindowFromModelOverride, ContextWindowFromProvider, ContextWindowFromModelCatalog} {
+		if !source.IsEstablished() {
+			t.Fatalf("%s should count as established", source)
+		}
+	}
+	if ContextWindowUnestablished.IsEstablished() {
+		t.Fatal("nothing-established reports itself as established")
+	}
+}
+
+// The tokens are stable because they also appear in machine-read output.
+func TestContextWindowSourceTokens(t *testing.T) {
+	for source, want := range map[ContextWindowSource]string{
+		ContextWindowUnestablished:     "unestablished",
+		ContextWindowFromModelOverride: "model_override",
+		ContextWindowFromProvider:      "provider",
+		ContextWindowFromModelCatalog:  "model_catalog",
+		ContextWindowFromFallback:      "fallback",
+	} {
+		if got := source.String(); got != want {
+			t.Errorf("%d = %q, want %q", source, got, want)
+		}
+	}
+}
