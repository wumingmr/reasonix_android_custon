index 76dc7c5a3aa0e568e18c89e1f5ddbc223db1bbed..a6137d97691b23d465819e7ebe4aeedb9a32b8e9 100644
--- a/internal/session/history_locator.go
+++ b/internal/session/history_locator.go
@@ -494,6 +494,84 @@ func (q *Query) HistoryShape(ctx context.Context, ref SessionRef) (HistoryShape,
 	return shape, nil
 }
 
+// HistoryTail materializes the last min(maxMessages, total) messages of a
+// session from the locator index, oldest-first. Interactive TUI replay only
+// needs the recent tail; reading it through the index avoids replaying the
+// whole event log on every resume. maxMessages <= 0 is an error; callers
+// wanting full history should use History instead.
+func (q *Query) HistoryTail(ctx context.Context, ref SessionRef, maxMessages int) ([]provider.Message, error) {
+	if q == nil {
+		return nil, errors.New("session: nil query")
+	}
+	if maxMessages <= 0 {
+		return nil, errors.New("session: history tail size must be positive")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := ref.validate(q.hostID); err != nil {
+		return nil, err
+	}
+	filesystem, path, err := q.prepareHistoryIndex(ctx, ref)
+	if err != nil {
+		return nil, err
+	}
+	handle, err := projectiondb.Open(ctx, projectiondb.OpenOptions{Path: path, Migrations: historyMigrations, RequireDisk: true, MaxOpenConns: 1})
+	if err != nil {
+		return nil, err
+	}
+	defer handle.DB.Close()
+	var snapshot uint64
+	if err := scanMetadataUint(handle.DB.QueryRowContext(ctx, `SELECT value FROM metadata WHERE key='durable_sequence'`), &snapshot); err != nil {
+		return nil, err
+	}
+	var total int64
+	if err := handle.DB.QueryRowContext(ctx, `SELECT COUNT(*) FROM messages WHERE event_sequence<=? AND (valid_to=0 OR valid_to>?)`, snapshot, snapshot).Scan(&total); err != nil {
+		return nil, err
+	}
+	if total == 0 {
+		return []provider.Message{}, nil
+	}
+	// Select the tail by ORDER BY position DESC + LIMIT rather than deriving a
+	// boundary from COUNT(*): position is assigned from a running counter that a
+	// retract-then-reinsert can leave non-contiguous, so count arithmetic could
+	// silently return fewer (or older) rows than asked for.
+	rows, err := handle.DB.QueryContext(ctx, `SELECT inline,content_digest,content_bytes,content_index_digest FROM messages WHERE event_sequence<=? AND (valid_to=0 OR valid_to>?) ORDER BY position DESC LIMIT ?`, snapshot, snapshot, maxMessages)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	content := contentStoreForSessionDir(filepath.Join(filesystem.Root, ref.SessionID))
+	messages := make([]provider.Message, 0, min(total, int64(maxMessages)))
+	for rows.Next() {
+		var inline []byte
+		var digest, indexDigest string
+		var contentBytes int64
+		if err := rows.Scan(&inline, &digest, &contentBytes, &indexDigest); err != nil {
+			return nil, err
+		}
+		body := json.RawMessage(inline)
+		if digest != "" {
+			body, err = resolveContentPayload(ctx, content, sessioncontent.Ref{Digest: digest, Bytes: contentBytes, IndexDigest: indexDigest, IntegrityBlock: sessioncontent.IntegrityBlockBytes, MediaType: "application/json"})
+			if err != nil {
+				return nil, err
+			}
+		}
+		var message provider.Message
+		if err := json.Unmarshal(body, &message); err != nil {
+			return nil, fmt.Errorf("session: decode indexed message: %w", err)
+		}
+		messages = append(messages, message)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	// Rows arrived newest-first; History and the TUI replay both expect the
+	// oldest-first order a session projection produces.
+	slices.Reverse(messages)
+	return messages, nil
+}
+
 // HistoryWindow materializes exactly [start,end) from a previously obtained
 // durable snapshot. The snapshot must still be representable by the current
 // projection; an append is allowed because version intervals retain the old
diff --git a/internal/session/history_tail_test.go b/internal/session/history_tail_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c9bbbf6fbf8fe0395b942b29550494d2d7e75bf6
--- /dev/null
+++ b/internal/session/history_tail_test.go
@@ -0,0 +1,126 @@
+package session
+
+import (
+	"context"
+	"encoding/json"
+	"path/filepath"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// HistoryTail must return the newest maxMessages entries in oldest-first order,
+// and it must agree exactly with the suffix of full History(). Reading the tail
+// through the locator index is what lets a TUI resume skip a whole-log replay,
+// so a divergence here would silently corrupt the resumed transcript.
+func TestHistoryTailMatchesFullHistorySuffix(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "sessions-v4")
+	service, err := NewService("local", NewFilesystemPersistence(root))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.CloseAll(context.Background()) })
+	runtime, err := service.Create(t.Context(), CreateOptions{SessionID: "tailed"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.Close(context.Background(), runtime.Ref()) })
+	appendWindowMessages(t, runtime, "m1", "m2", "m3", "m4", "m5")
+	ref := runtime.Ref()
+	query := service.Query()
+
+	full, err := query.History(t.Context(), ref)
+	if err != nil {
+		t.Fatalf("History: %v", err)
+	}
+	if len(full) != 5 {
+		t.Fatalf("full history = %d messages, want 5", len(full))
+	}
+
+	tail, err := query.HistoryTail(t.Context(), ref, 2)
+	if err != nil {
+		t.Fatalf("HistoryTail: %v", err)
+	}
+	want := full[len(full)-2:]
+	if len(tail) != len(want) {
+		t.Fatalf("tail = %d messages, want %d", len(tail), len(want))
+	}
+	for i := range want {
+		if tail[i].ID != want[i].ID || tail[i].Content != want[i].Content {
+			t.Fatalf("tail[%d] = %+v, want %+v", i, tail[i], want[i])
+		}
+	}
+
+	// A limit at or above the message count returns everything, still oldest-first.
+	all, err := query.HistoryTail(t.Context(), ref, 50)
+	if err != nil {
+		t.Fatalf("HistoryTail(all): %v", err)
+	}
+	if len(all) != len(full) {
+		t.Fatalf("tail(all) = %d messages, want %d", len(all), len(full))
+	}
+	for i := range full {
+		if all[i].ID != full[i].ID {
+			t.Fatalf("tail(all)[%d] = %q, want %q", i, all[i].ID, full[i].ID)
+		}
+	}
+
+	if _, err := query.HistoryTail(t.Context(), ref, 0); err == nil {
+		t.Fatal("HistoryTail accepted a non-positive limit")
+	}
+}
+
+// A retracted message frees its position without renumbering, so positions can
+// be non-contiguous. The tail must still return exactly maxMessages newest rows
+// instead of deriving a cutoff from COUNT(*).
+func TestHistoryTailToleratesPositionGaps(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "sessions-v4")
+	service, err := NewService("local", NewFilesystemPersistence(root))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.CloseAll(context.Background()) })
+	runtime, err := service.Create(t.Context(), CreateOptions{SessionID: "gapped"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.Close(context.Background(), runtime.Ref()) })
+	appendWindowMessages(t, runtime, "m1", "m2", "m3", "m4", "m5")
+
+	// Retract the middle message, then append a new one: position 3 is retired
+	// and the new message takes the next counter value, leaving a hole.
+	retract, err := json.Marshal(map[string]any{"messageIds": []string{"m3"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := runtime.Session().Append(t.Context(), Batch{
+		OperationID: "retract-m3",
+		Events:      []Event{{Kind: "message/retract", Payload: retract}},
+	}); err != nil {
+		t.Fatalf("retract: %v", err)
+	}
+	appendWindowMessages(t, runtime, "m6")
+
+	ref := runtime.Ref()
+	query := service.Query()
+	full, err := query.History(t.Context(), ref)
+	if err != nil {
+		t.Fatalf("History: %v", err)
+	}
+	tail, err := query.HistoryTail(t.Context(), ref, 3)
+	if err != nil {
+		t.Fatalf("HistoryTail: %v", err)
+	}
+	want := full[len(full)-3:]
+	if len(tail) != len(want) {
+		t.Fatalf("tail = %d messages, want %d (full=%d)", len(tail), len(want), len(full))
+	}
+	for i := range want {
+		if tail[i].ID != want[i].ID {
+			t.Fatalf("tail[%d] = %q, want %q", i, tail[i].ID, want[i].ID)
+		}
+	}
+	if tail[len(tail)-1].Role != provider.RoleUser {
+		t.Fatalf("tail tail role = %q", tail[len(tail)-1].Role)
+	}
+}
