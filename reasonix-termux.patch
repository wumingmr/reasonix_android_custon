diff --git a/internal/provider/openai/context_metadata.go b/internal/provider/openai/context_metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..a4aed2860b899f7c11569becd60a0a18f9c67b6c
--- /dev/null
+++ b/internal/provider/openai/context_metadata.go
@@ -0,0 +1,87 @@
+package openai
+
+import "encoding/json"
+
+// modelCapacity is what one /models row declares about how much it can hold.
+// Zero means the row said nothing: an absent field is not a claim that the
+// model has no limit, so callers must treat zero as "unknown", never as "none".
+type modelCapacity struct {
+	// ContextWindow is the total prompt+completion budget the endpoint reports.
+	ContextWindow int
+	// MaxOutputTokens is the completion ceiling the endpoint reports, when it
+	// reports one separately from the window.
+	MaxOutputTokens int
+}
+
+// modelCapacityKeys are read in order; the first positive value wins. Official
+// OpenAI-shaped listings use none of them, vLLM/SGLang use max_model_len,
+// Together and Groq use context_length, and several aggregators use
+// max_context_length or max_input_tokens.
+var (
+	modelContextWindowKeys   = []string{"context_length", "max_context_length", "max_model_len", "max_input_tokens"}
+	modelMaxOutputTokenKeys  = []string{"max_completion_tokens", "max_output_tokens"}
+	modelCapacityNestedScope = []string{"top_provider", "capabilities", "limits"}
+)
+
+// parseModelCapacity reads a listing row's declared capacity. Nested scopes are
+// consulted after the top level, because a row that states its own numbers is
+// more specific than the provider block summarising them.
+func parseModelCapacity(entry map[string]json.RawMessage) modelCapacity {
+	out := modelCapacity{
+		ContextWindow:   firstPositiveInt(entry, modelContextWindowKeys),
+		MaxOutputTokens: firstPositiveInt(entry, modelMaxOutputTokenKeys),
+	}
+	if out.ContextWindow > 0 && out.MaxOutputTokens > 0 {
+		return out
+	}
+	for _, scope := range modelCapacityNestedScope {
+		var nested map[string]json.RawMessage
+		if json.Unmarshal(entry[scope], &nested) != nil {
+			continue
+		}
+		if out.ContextWindow <= 0 {
+			out.ContextWindow = firstPositiveInt(nested, modelContextWindowKeys)
+		}
+		if out.MaxOutputTokens <= 0 {
+			out.MaxOutputTokens = firstPositiveInt(nested, modelMaxOutputTokenKeys)
+		}
+		if out.ContextWindow > 0 && out.MaxOutputTokens > 0 {
+			return out
+		}
+	}
+	return out
+}
+
+// firstPositiveInt returns the first key whose value decodes as a positive
+// integer. A malformed or non-positive value is skipped rather than clamped:
+// "0" and "-1" are how some listings spell "not applicable", and adopting them
+// would either disable compaction or claim a ceiling nobody stated.
+func firstPositiveInt(entry map[string]json.RawMessage, keys []string) int {
+	for _, key := range keys {
+		raw, present := entry[key]
+		if !present {
+			continue
+		}
+		var value int
+		if json.Unmarshal(raw, &value) == nil && value > 0 {
+			return value
+		}
+	}
+	return 0
+}
+
+// mergeModelCapacity folds a duplicate row for the same model id into what is
+// already known. The smaller positive window wins: overstating a window makes
+// the provider reject a request, while understating it only compacts earlier,
+// and a listing that repeats an id is usually two routes onto the same model
+// with different headroom.
+func mergeModelCapacity(previous, next modelCapacity) modelCapacity {
+	out := previous
+	if next.ContextWindow > 0 && (out.ContextWindow <= 0 || next.ContextWindow < out.ContextWindow) {
+		out.ContextWindow = next.ContextWindow
+	}
+	if next.MaxOutputTokens > 0 && (out.MaxOutputTokens <= 0 || next.MaxOutputTokens < out.MaxOutputTokens) {
+		out.MaxOutputTokens = next.MaxOutputTokens
+	}
+	return out
+}
diff --git a/internal/provider/openai/context_metadata_test.go b/internal/provider/openai/context_metadata_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6dbc7b35a52352fdb56aaa6d26befd69c61cbada
--- /dev/null
+++ b/internal/provider/openai/context_metadata_test.go
@@ -0,0 +1,78 @@
+package openai
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// A listing that states capacity is the only free source of truth about it.
+// The window is read from whichever spelling the endpoint chose, because
+// OpenAI-compatible gateways disagree on all of them.
+func TestParseModelCapacityReadsTheDeclaredWindow(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		row  string
+		want modelCapacity
+	}{
+		{"openrouter", `{"id":"m","context_length":1048576,"top_provider":{"max_completion_tokens":131072}}`,
+			modelCapacity{ContextWindow: 1048576, MaxOutputTokens: 131072}},
+		{"vllm", `{"id":"m","max_model_len":32768}`, modelCapacity{ContextWindow: 32768}},
+		{"nested only", `{"id":"m","top_provider":{"context_length":65536}}`, modelCapacity{ContextWindow: 65536}},
+		{"top level wins", `{"id":"m","context_length":8192,"top_provider":{"context_length":65536}}`,
+			modelCapacity{ContextWindow: 8192}},
+		{"output only", `{"id":"m","max_output_tokens":4096}`, modelCapacity{MaxOutputTokens: 4096}},
+		{"silent", `{"id":"m"}`, modelCapacity{}},
+		// "0" and "-1" are how some listings spell "not applicable". Adopting
+		// either would disable compaction or claim a ceiling nobody stated.
+		{"zero", `{"id":"m","context_length":0}`, modelCapacity{}},
+		{"negative", `{"id":"m","context_length":-1}`, modelCapacity{}},
+		{"wrong type", `{"id":"m","context_length":"1048576"}`, modelCapacity{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var entry map[string]json.RawMessage
+			if err := json.Unmarshal([]byte(tc.row), &entry); err != nil {
+				t.Fatal(err)
+			}
+			if got := parseModelCapacity(entry); got != tc.want {
+				t.Fatalf("capacity = %+v, want %+v", got, tc.want)
+			}
+		})
+	}
+}
+
+// A window belongs to the model, so the metadata and the capacity travel
+// independently: either can be present without the other.
+func TestParseModelTupleKeepsMetadataAndCapacitySeparate(t *testing.T) {
+	info, capacity := parseModelTuple("https://relay.example.com/v1",
+		[]byte(`{"id":"m","context_length":1000,"input_modalities":["text"]}`))
+	if info.ID != "m" || len(info.InputModalities) != 1 {
+		t.Fatalf("info = %+v", info)
+	}
+	if capacity.ContextWindow != 1000 {
+		t.Fatalf("capacity = %+v", capacity)
+	}
+
+	info, capacity = parseModelTuple("https://relay.example.com/v1", []byte(`{"id":"m"}`))
+	if info.ID != "m" || info.InputModalities != nil {
+		t.Fatalf("info = %+v", info)
+	}
+	if capacity != (modelCapacity{}) {
+		t.Fatalf("capacity = %+v, want none", capacity)
+	}
+}
+
+// A listing that repeats an id is usually two routes onto the same model with
+// different headroom. Overstating the window makes the provider refuse a
+// request, understating it only compacts earlier, so the smaller one wins.
+func TestMergeModelCapacityPrefersTheSmallerBound(t *testing.T) {
+	merged := mergeModelCapacity(
+		modelCapacity{ContextWindow: 200_000, MaxOutputTokens: 8_000},
+		modelCapacity{ContextWindow: 128_000, MaxOutputTokens: 16_000},
+	)
+	if merged.ContextWindow != 128_000 || merged.MaxOutputTokens != 8_000 {
+		t.Fatalf("merged = %+v", merged)
+	}
+	if merged := mergeModelCapacity(modelCapacity{}, modelCapacity{}); merged.ContextWindow != 0 || merged.MaxOutputTokens != 0 {
+		t.Fatalf("merging two silent rows invented %+v", merged)
+	}
+}
