+	selectSetupModels = func(_ string, items []menuItem) ([]int, error) {
+		if len(items) != 2 || !strings.Contains(items[0].desc, i18n.M.SetupImageSupported) || !strings.Contains(items[1].desc, i18n.M.SetupImageUnknown) {
