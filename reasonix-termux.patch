+++ b/scripts/termux/compat.test.mjs
@@ -0,0 +1,189 @@
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { chmodSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '../..');
+const tmpRoot = process.env.REASONIX_TMPDIR || join(homedir(), 'tmp');
+mkdirSync(tmpRoot, { recursive: true });
+function fixture(t) {
+  const dir = mkdtempSync(join(tmpRoot, 'reasonix-compat-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+function run(command, args, cwd, env = {}) {
+  return spawnSync(command, args, {
+    cwd, env: { ...process.env, ...env }, encoding: 'utf8', timeout: 30000,
+  });
+}
+function git(dir, ...args) {
+  const result = run('git', ['-c', 'user.name=fixture', '-c', 'user.email=fixture@invalid', ...args], dir);
+  assert.equal(result.status, 0, result.stderr);
+  return result.stdout.trim();
+}
+
+// A recorder catches argv ordering without creating an agent session.
+test('wrapper preserves command dispatch and explicit permission choices', t => {
+  const dir = fixture(t);
+  const real = join(dir, 'real');
+  writeFileSync(real, `#!${process.execPath}\nprocess.stdout.write(JSON.stringify(process.argv.slice(2)));\n`);
+  chmodSync(real, 0o755);
+  const mode = ['--permission-mode', 'danger-full-access'];
+  const cases = [
+    [[], mode],
+    [['run', 'hello world'], ['run', ...mode, 'hello world']],
+    [['chat', '--resume'], ['chat', ...mode, '--resume']],
+    [['code'], ['code', ...mode]],
+    [['-p', 'hello'], [...mode, '-p', 'hello']],
+    [['run', '--', '--permission-mode'], ['run', ...mode, '--', '--permission-mode']],
+    [['run', '--permission-mode=read-only', 'hello'], ['run', '--permission-mode=read-only', 'hello']],
+    [['run', '--auto', 'hello'], ['run', '--auto', 'hello']],
+    [['run', '-y', 'hello'], ['run', '-y', 'hello']],
+  ];
+  for (const name of ['remote', 'plugin', 'session', 'sessions', 'catalogs', 'update', 'hooks', 'review', 'docs-manifest', '--acp', '--help', '--version', 'future-command']) {
+    cases.push([[name], [name]]);
+  }
+  for (const [args, expected] of cases) {
+    const result = run('bash', [join(root, 'scripts/termux/reasonix-wrapper'), ...args], dir, { REASONIX_REAL: real, REASONIX_FULL_ACCESS: '1', REASONIX_PERMISSION_MODE: 'danger-full-access' });
+    assert.equal(result.status, 0, result.stderr);
+    assert.deepEqual(JSON.parse(result.stdout), expected, `args ${JSON.stringify(args)}`);
+  }
+  const optOut = run('bash', [join(root, 'scripts/termux/reasonix-wrapper'), 'run', 'hello'], dir, { REASONIX_REAL: real, REASONIX_FULL_ACCESS: '0' });
+  assert.deepEqual(JSON.parse(optOut.stdout), ['run', 'hello']);
+});
+
+function updateFixture(t) {
+  const dir = fixture(t);
+  const script = readFileSync(join(root, 'update-reasonix.sh'), 'utf8');
+  const names = new Set(['update-reasonix.sh', 'reasonix-termux.patch', 'release-notes/releases.json', '.gitignore', '.gitattributes']);
+  for (const match of script.matchAll(/"(internal\/[^":]+):/g)) names.add(match[1]);
+  // Script sentinels and workflow contracts live outside the cumulative patch.
+  names.add('scripts/termux/reasonix-wrapper');
+  names.add('scripts/termux/compat.test.mjs');
+  names.add('.github/workflows/build_termux.yml');
+  names.add('.github/workflows/verify-and-release.yml');
+  names.add('release-termux.sh');
+  names.add('scripts/termux/release-identity.sh');
+  for (const name of names) {
+    mkdirSync(dirname(join(dir, name)), { recursive: true });
+    copyFileSync(join(root, name), join(dir, name));
+  }
+  writeFileSync(join(dir, 'tracked.txt'), 'original user content\n');
+  git(dir, 'init', '-q');
+  git(dir, 'add', '.');
+  git(dir, 'commit', '-qm', 'fixture');
+  return dir;
+}
+
+function updateWithShim(t, dir, body) {
+  const shim = fixture(t);
+  const trace = join(shim, 'trace');
+  const realGit = run('bash', ['-c', 'command -v git'], dir).stdout.trim();
+  const realBash = run('bash', ['-c', 'command -v bash'], dir).stdout.trim();
+  writeFileSync(join(shim, 'git'), `#!${realBash}\nprintf '%s\\n' "$*" >> "$TRACE"\n${body}\nexec "${realGit}" "$@"\n`);
+  chmodSync(join(shim, 'git'), 0o755);
+  const result = run('bash', [join(dir, 'update-reasonix.sh')], dir, {
+    PATH: `${shim}:${process.env.PATH}`, TRACE: trace, KEEP_CHANGES: '0',
+    REASONIX_TAG: '', REASONIX_REPO_URL: 'https://invalid.example/upstream',
+    TERMUX_PATCH_FILE: join(dir, 'reasonix-termux.patch'), TMPDIR: tmpRoot,
+  });
+  const calls = existsSync(trace) ? readFileSync(trace, 'utf8') : '';
+  return { result, calls };
+}
+
+test('update refuses tracked and untracked edits before network or rollback', t => {
+  for (const staged of [false, true]) {
+    const dir = updateFixture(t);
+    writeFileSync(join(dir, 'tracked.txt'), 'unsaved edit\n');
+    writeFileSync(join(dir, 'untracked.txt'), 'unsaved data\n');
+    if (staged) git(dir, 'add', 'tracked.txt');
+    const { result, calls } = updateWithShim(t, dir, '');
+    assert.notEqual(result.status, 0);
+    assert.match(result.stderr, /拒绝升级/);
+    assert.doesNotMatch(calls, /ls-remote|reset|clean|^rm /m);
+    assert.equal(readFileSync(join(dir, 'tracked.txt'), 'utf8'), 'unsaved edit\n');
+    assert.equal(readFileSync(join(dir, 'untracked.txt'), 'utf8'), 'unsaved data\n');
+  }
+});
+
+test('update network failure leaves ignored data and HEAD untouched', t => {
+  const dir = updateFixture(t);
+  const before = git(dir, 'rev-parse', 'HEAD');
+  mkdirSync(join(dir, 'bin'));
+  writeFileSync(join(dir, 'bin/user-data'), 'ignored output\n');
+  const { result, calls } = updateWithShim(t, dir, 'if [ "${1-}" = ls-remote ]; then exit 128; fi');
+  assert.notEqual(result.status, 0);
+  assert.match(calls, /ls-remote/, result.stderr);
+  assert.doesNotMatch(calls, /reset|clean|^rm /m);
+  assert.equal(git(dir, 'rev-parse', 'HEAD'), before);
+  assert.equal(readFileSync(join(dir, 'bin/user-data'), 'utf8'), 'ignored output\n');
+});
+
+test('update checkout failure rolls back only tracked source paths', t => {
+  const dir = updateFixture(t);
+  const before = git(dir, 'rev-parse', 'HEAD');
+  mkdirSync(join(dir, 'bin'));
+  writeFileSync(join(dir, 'bin/user-data'), 'ignored output\n');
+  const body = `case "${'${1-}'}" in
+    ls-remote) printf '1234567890123456789012345678901234567890\\trefs/tags/v1.99.0\\n'; exit 0;;
+    fetch) exit 0;;
+    checkout) printf 'late user data\\n' > late-untracked.txt; exit 1;;
+  esac`;
+  const { result, calls } = updateWithShim(t, dir, body);
+  assert.notEqual(result.status, 0);
+  assert.match(calls, /^reset --hard /m, result.stderr);
+  assert.doesNotMatch(calls, /\bclean\b/);
+  assert.equal(git(dir, 'rev-parse', 'HEAD'), before);
+  assert.equal(readFileSync(join(dir, 'tracked.txt'), 'utf8'), 'original user content\n');
+  assert.equal(readFileSync(join(dir, 'late-untracked.txt'), 'utf8'), 'late user data\n');
+  assert.equal(readFileSync(join(dir, 'bin/user-data'), 'utf8'), 'ignored output\n');
+});
+
+test('release rejects version mismatches and requires an existing tag', () => {
+  const release = readFileSync(join(root, 'release-termux.sh'), 'utf8');
+  assert.ok(release.includes('[ "$BIN_BASE" = "${TAG#v}" ] ||'));
+  assert.ok(release.indexOf('产物版本') < release.indexOf('git add "artifacts/'));
+  const workflow = readFileSync(join(root, '.github/workflows/verify-and-release.yml'), 'utf8');
+  assert.ok(workflow.includes('--verify-tag'));
+});
+
+test('release identity accepts revisions and rejects mismatches', () => {
+  const helper = join(root, 'scripts/termux/release-identity.sh');
+  const cases = [
+    ['v1.39.11', 'termux-v1.39.11', true],
+    ['v1.39.11', 'termux-v1.39.11-r1', true],
+    ['v1.39.11', 'termux-v1.39.11-r12', true],
+    ['v1.39.11', 'termux-v1.39.10-r1', false],
+    ['v1.39.11', 'termux-v1.39.11-r0', false],
+    ['v1.39.11', 'termux-v1.39.11;echo unsafe', false],
+    ['v2.57.0', 'termux-v2.57.0', false],
+  ];
+  for (const [upstream, tag, ok] of cases) {
+    const result = run('bash', ['-c', 'source "$1"; termux_release_identity "$2" "$3" && printf "%s\\n" "$TERMUX_RELEASE_ASSET"', 'bash', helper, upstream, tag], root);
+    assert.equal(result.status === 0, ok, result.stderr);
+    if (ok) assert.equal(result.stdout.trim(), `reasonix-android-arm64-${tag.slice(7)}`);
+  }
+  for (const [version, ok] of [['1.39.11-termux.abc12345', true], ['1.39.10-termux.abc12345', false], ['1.39.11', false]]) {
+    const result = run('bash', ['-c', 'source "$1"; termux_verify_binary_version "$2" v1.39.11', 'bash', helper, version], root);
+    assert.equal(result.status === 0, ok);
+  }
+});
+
+test('update verifies local adaptations without touching the network', t => {
+  const dir = updateFixture(t);
+  const result = run('bash', [join(dir, 'update-reasonix.sh'), '--verify-local'], dir, { TERMUX_PATCH_FILE: join(dir, 'reasonix-termux.patch') });
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /本地修复符号与关键测试校验通过/);
+  const source = readFileSync(join(root, 'update-reasonix.sh'), 'utf8');
+  assert.ok(source.indexOf('verify_local_adaptations', source.indexOf('git apply --index')) > source.indexOf('git apply --index'));
+});
+
+test('Termux workflow builds the exact repository revision', () => {
+  const workflow = readFileSync(join(root, '.github/workflows/build_termux.yml'), 'utf8');
+  assert.ok(workflow.includes('https://codeload.github.com/${{ github.repository }}/tar.gz/${{ github.sha }}'));
+  assert.ok(workflow.includes('VERSION="$TERMUX_PKG_VERSION-termux.${revision:0:8}"'));
+  assert.doesNotMatch(workflow, /lengxiaohua123|refs\/heads\/master/);
+});
diff --git a/scripts/termux/install-wrapper.sh b/scripts/termux/install-wrapper.sh
new file mode 100755
index 0000000000000000000000000000000000000000..93e5661aebfdc92675c1f00ae413875f788db44d
--- /dev/null
+++ b/scripts/termux/install-wrapper.sh
@@ -0,0 +1,165 @@
+#!/data/data/com.termux/files/usr/bin/bash
+# One-command installer for the Reasonix Termux permission wrappers.
+#
+# Default (safer): install reasonix-full + reasonix-raw beside the real binary.
+#   curl -fsSL https://raw.githubusercontent.com/wumingmr/reasonix_android_custon/master/scripts/termux/install-wrapper.sh | bash
+#
+# Make `reasonix` itself default to Full access:
+#   curl -fsSL URL | bash -s -- --default-full
+#
+# Remove only files managed by this installer:
+#   curl -fsSL URL | bash -s -- --uninstall
+set -euo pipefail
+
+REPO="${REASONIX_WRAPPER_REPO:-wumingmr/reasonix_android_custon}"
+REF="${REASONIX_WRAPPER_REF:-master}"
+BASE_URL="${REASONIX_WRAPPER_BASE_URL:-https://raw.githubusercontent.com/$REPO/$REF/scripts/termux}"
+PREFIX_DIR="${PREFIX:-/data/data/com.termux/files/usr}"
+REAL="$PREFIX_DIR/bin/reasonix"
+HELPER_DIR="$PREFIX_DIR/bin"
+HOME_BIN="$HOME/bin"
+MODE="safe"
+
+log() { printf '[reasonix-wrapper] %s\n' "$*"; }
+die() { printf '[reasonix-wrapper] 错误: %s\n' "$*" >&2; exit 1; }
+usage() {
+  cat <<'EOF'
+用法: install-wrapper.sh [--default-full|--uninstall]
+
+  无参数          安装 reasonix-full 和 reasonix-raw（不覆盖 reasonix）
+  --default-full  另装 ~/bin/reasonix，使 reasonix 默认 danger-full-access
+  --uninstall     仅删除本安装器管理的 wrapper，不删除真实二进制
+EOF
+}
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --default-full) MODE="default-full" ;;
+    --uninstall) MODE="uninstall" ;;
+    -h|--help) usage; exit 0 ;;
+    *) usage >&2; die "未知参数: $1" ;;
+  esac
+  shift
+done
+
+is_managed() {
+  local path="$1"
+  [ -f "$path" ] || return 1
+  grep -qE '^(# Termux wrapper: interactive/run commands default to danger-full-access\.|# Invoke the real Termux Reasonix binary without injecting a permission mode\.)$' "$path"
+}
+
+remove_managed() {
+  local path="$1"
+  if is_managed "$path"; then
+    rm -f "$path"
+    log "已删除 $path"
+  elif [ -e "$path" ]; then
+    log "保留非本安装器管理的文件: $path"
+  fi
+}
+
+if [ "$MODE" = "uninstall" ]; then
+  remove_managed "$HELPER_DIR/reasonix-full"
+  remove_managed "$HELPER_DIR/reasonix-raw"
+  remove_managed "$HOME_BIN/reasonix"
+  log "卸载完成；真实二进制 $REAL 未改动"
+  exit 0
+fi
+
+[ -x "$REAL" ] || die "真实二进制不存在或不可执行: $REAL。请先安装 Reasonix Android 二进制。"
+command -v curl >/dev/null 2>&1 || die "需要 curl；请先运行: pkg install curl"
+
+TMP_ROOT="${REASONIX_TMPDIR:-$HOME/tmp}"
+mkdir -p "$TMP_ROOT"
+WORK="$(mktemp -d "$TMP_ROOT/reasonix-wrapper-XXXXXX")"
+cleanup() { rm -rf "$WORK"; }
+trap cleanup EXIT
+
+fetch() {
+  local name="$1" out="$2"
+  curl -fsSL --retry 3 --connect-timeout 15 "$BASE_URL/$name" -o "$out" || \
+    die "下载失败: $BASE_URL/$name"
+}
+
+fetch reasonix-wrapper "$WORK/reasonix-wrapper"
+fetch reasonix-raw "$WORK/reasonix-raw"
+
+grep -q '^# Termux wrapper: interactive/run commands default to danger-full-access\.$' "$WORK/reasonix-wrapper" || \
+  die "下载的 reasonix-wrapper 格式异常"
+grep -q '^# Invoke the real Termux Reasonix binary without injecting a permission mode\.$' "$WORK/reasonix-raw" || \
+  die "下载的 reasonix-raw 格式异常"
+bash -n "$WORK/reasonix-wrapper"
+bash -n "$WORK/reasonix-raw"
+
+backup_unmanaged() {
+  local path="$1" backup stamp n
+  [ -e "$path" ] || return 0
+  is_managed "$path" && return 0
+  stamp="$(date +%Y%m%d-%H%M%S)"
+  backup="$path.backup-$stamp"
+  n=1
+  while [ -e "$backup" ]; do
+    backup="$path.backup-$stamp-$n"
+    n=$((n + 1))
+  done
+  mv "$path" "$backup"
+  log "原文件不是本安装器管理的 wrapper，已备份到 $backup"
+}
+
+install_atomic() {
+  local source="$1" target="$2" temp
+  mkdir -p "$(dirname "$target")"
+  backup_unmanaged "$target"
+  temp="$(dirname "$target")/.${target##*/}.new.$$"
+  install -m 755 "$source" "$temp"
+  mv -f "$temp" "$target"
+  log "已安装 $target"
+}
+
+# Safe aliases live beside the real binary and are immediately on Termux PATH.
+install_atomic "$WORK/reasonix-wrapper" "$HELPER_DIR/reasonix-full"
+install_atomic "$WORK/reasonix-raw" "$HELPER_DIR/reasonix-raw"
+
+if [ "$MODE" = "default-full" ]; then
+  install_atomic "$WORK/reasonix-wrapper" "$HOME_BIN/reasonix"
+
+  case ":$PATH:" in
+    *":$HOME_BIN:"*) ;;
+    *)
+      shell_name="${SHELL##*/}"
+      case "$shell_name" in
+        zsh) rc="$HOME/.zshrc" ;;
+        bash) rc="$HOME/.bashrc" ;;
+        *) rc="$HOME/.profile" ;;
+      esac
+      marker='# Reasonix Termux wrapper PATH'
+      if ! grep -Fq "$marker" "$rc" 2>/dev/null; then
+        printf '\n%s\nexport PATH="$HOME/bin:$PATH"\n' "$marker" >> "$rc"
+        log "已将 ~/bin PATH 写入 $rc（重新打开终端后生效）"
+      fi
+      ;;
+  esac
+
+  cat <<'EOF'
+
+已启用默认 Full access：新终端中的 `reasonix` 会注入 danger-full-access。
+当前终端若尚未找到 ~/bin/reasonix，请执行：
+  export PATH="$HOME/bin:$PATH"; hash -r
+
+恢复原始权限行为：
+  reasonix-raw ...
+  REASONIX_FULL_ACCESS=0 reasonix ...
+EOF
+else
+  cat <<'EOF'
+
+已完成安全默认安装（没有覆盖 `reasonix`）：
+  reasonix-full ...  # 默认 danger-full-access
+  reasonix-raw ...   # 不注入权限模式
+
+若明确希望 `reasonix` 本身默认 Full access，请重新运行一键命令并加：
+  --default-full
+EOF
+fi
+
+log "警告: danger-full-access 关闭 Reasonix OS 沙箱；只用于可信任务。"
