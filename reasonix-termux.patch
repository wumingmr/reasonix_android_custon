+	}
+	if len(pending) != 2 {
+		t.Fatalf("pending = %v, want the 2 held-back bytes", pending)
+	}
+	// The rest of the character arrives on the next read and completes it.
+	got, pending = searchText(got, pending, []byte{0x88})
+	if got != "鹈" {
